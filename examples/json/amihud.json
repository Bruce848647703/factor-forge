      "description": "s日的收益率"
    },
    {
      "symbol": "Amount_{i,s}",
      "name_cn": "s日的成交额",
      "data_field": "amount",
      "description": "s日的成交额"
    },
    {
      "symbol": "mean",
      "name_cn": "过去20个交易日的均值",
      "data_field": "",
      "description": "过去20个交易日的均值"
    }
  ],
  "direction": 1,
